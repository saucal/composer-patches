{
    "name": "saucal/composer-patches",
    "description": "Re-applies cweagans/composer-patches patches on install/update when patches.lock.json changed.",
    "type": "composer-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "composer-plugin-api": "^2.0",
        "cweagans/composer-patches": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Saucal\\ComposerPatches\\": "src/"
        }
    },
    "extra": {
        "class": "Saucal\\ComposerPatches\\Plugin"
    }
}
